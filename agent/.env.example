# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase -------------------------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> JWT Keys -> Legacy JWT secret.
# Leave empty if your project uses the new asymmetric signing keys;
# the agent then verifies tokens with the project's public JWKS.
SUPABASE_JWT_SECRET=
# Connect (top bar) -> Session pooler -> URI. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Gemini ---------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match vector(768) in supabase/schema.sql
GEMINI_EMBED_DIM=768

# --- Agent ----------------------------------------------------------
# gemini = real AI. fake = offline stand-in for tests/demos (no key needed).
LLM_PROVIDER=gemini
# supabase = Supabase Storage. local = files on disk (LOCAL_STORAGE_DIR).
STORAGE_BACKEND=supabase
LOCAL_STORAGE_DIR=./storage
# Comma-separated frontend URLs allowed to call the agent
CORS_ORIGINS=http://localhost:3000
# NEVER true in production: enables POST /dev/token (login without Supabase).
DEV_AUTH=false
