# URL of the FastAPI agent
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true = show "Dev login" (agent must run with DEV_AUTH=true). Local testing only.
NEXT_PUBLIC_DEV_AUTH=false

# Optional single-URL mode: the app forwards /api/* to the agent.
# Set both at build time:  NEXT_PUBLIC_API_URL=/api  AGENT_PROXY_URL=http://localhost:8000
AGENT_PROXY_URL=
